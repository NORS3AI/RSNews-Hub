# SQLite database file (default). For production you can swap the datasource
# provider in prisma/schema.prisma to postgresql and point this at your DB.
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. Generate a long random string in production:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: absolute site URL used for metadata / Open Graph tags.
# SITE_URL="https://yoursite.com"
