# ── RS News Hub environment ────────────────────────────────────────────────
# Copy to `.env` for local dev. In production set these in your host's dashboard
# (never commit real values). See DEPLOYMENT.md for the full guide.

# Database connection.
#   Local dev (default):  SQLite file
#   Production:           Postgres — also change the datasource `provider` in
#                         prisma/schema.prisma from "sqlite" to "postgresql".
# The app runs on PostgreSQL (prisma/schema.prisma provider = postgresql).
# Local dev: `docker compose up db` gives you one at the URL below.
DATABASE_URL="postgresql://postgres:pass@localhost:5432/rsnews"
# Hosted: DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Postgresql creds
# POSTGRES_DB="rsnews"
# POSTGRES_USER="change_me"
# POSTGRES_PASSWORD="change_me!"

# Secret used to sign the hub's OWN session cookies (JWT), used only in
# AUTH_MODE=local. REQUIRED if you use local mode in production — the app refuses
# to issue sessions with a weak/placeholder value. Generate:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# ── How members are authenticated (see INTEGRATION.md) ────────────────────
# In production the hub is a gated area of the RS News site: the site verifies
# the member and the hub trusts that identity. Default "local" = the hub's own
# login (dev/standalone only; /login + /register are disabled in the other modes).
# AUTH_MODE="local"               # local | jwt | header
# --- AUTH_MODE=jwt (recommended for production) ---
# PARENT_JWT_SECRET="shared-hs256-secret-with-the-website"
# PARENT_SESSION_COOKIE="rsnews_sso"   # cookie the hub reads (default rsnews_sso)
# PARENT_JWT_ISSUER=""                 # optional, validated if set
# PARENT_JWT_AUDIENCE=""               # optional, validated if set
# --- AUTH_MODE=header (only behind a trusted proxy) ---
# PARENT_HEADER_ID="x-member-id"       # + x-member-email / -name / -type / -region / -store-type / -staff
#                                      # + entitlements: x-member-tier / -affiliations / -brand
#                                      # + testimonials: x-member-store-name, x-member-code (in-house only)

# Admin account created by `npm run db:seed`. REQUIRED in production so no site
# ever ships with the public demo admin login.
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="use-a-strong-password"

# Optional: absolute site URL used for metadata / Open Graph tags, robots.txt
# and sitemap.xml. Set this in production so canonical/OG URLs are correct.
# SITE_URL="https://yoursite.com"

# Optional: who may EMBED the hub in an iframe (CSP frame-ancestors). The hub is
# a gated area of the RS News site, so set this to the parent origin(s),
# space-separated. Defaults to same-origin only ('self'). Example:
# FRAME_ANCESTORS="'self' https://www.rsnews.com"

# Optional: transactional email (vendor ad reminders, welcome mail, etc.). With
# no provider key set the app LOGS messages instead of sending, so nothing is
# emailed by accident. Set EMAIL_FROM (your own verified sender address) plus one
# provider key. EMAIL_PROVIDER picks the transport if both keys are present;
# otherwise whichever key is set is used. Both use REST (no SDK).
# EMAIL_FROM="RS News Hub <no-reply@yoursite.com>"
# EMAIL_PROVIDER="resend"          # resend (default) | sendgrid
# RESEND_API_KEY="re_xxxxxxxx"     # Resend
# SENDGRID_API_KEY="SG.xxxxxxxx"   # SendGrid (verify EMAIL_FROM as a Single Sender / domain)

# Optional: the JotForm ad-order link the reminder emails point vendors to. Fills
# the {submitUrl} merge tag in the admin-editable email templates
# (/admin/email-templates). If unset, put the link directly in each template body.
# AD_ORDER_URL="https://form.jotform.com/your-ad-order-form"

# Optional: error tracking. Errors always hit the structured logs; setting a DSN
# and wiring the one-line forwarder (see DEPLOYMENT.md) also ships them to Sentry.
# SENTRY_DSN="https://xxxx@oxxxx.ingest.sentry.io/xxxx"

# Optional: who gets the integration-outage alert emails (the /api/cron/integrations
# monitor emails these addresses when a connection goes down or recovers).
# Comma-separated. Defaults to every active ADMIN user if unset. Needs EMAIL_FROM
# + a provider key above to actually send.
# ADMIN_ALERT_EMAIL="you@yourdomain.com,ops@yourdomain.com"

# ── Asset storage (comic/ad/cover image uploads) ──────────────────────────
# Default (all unset): images are stored on LOCAL DISK under UPLOAD_DIR and
# served at /uploads/... — zero config, works out of the box. For multi-instance
# or serverless hosting use S3/R2 instead (below). See DEPLOYMENT.md §3c.
# STORAGE_DRIVER="local"          # "local" (default) or "s3". Omit to auto-detect.
# UPLOAD_DIR="./uploads"          # local-disk storage dir (use a persistent volume)
# UPLOAD_MAX_MB="8"               # max image upload size in MB (default 8)
# UPLOAD_VIDEO_MAX_MB="20"        # max video-ad creative size in MB (default 20)
# UPLOAD_ALLOW_SVG="false"        # allow SVG uploads (off — SVG can carry script)
#
# S3 / Cloudflare R2 (S3-compatible). Set these to switch off local disk:
# S3_BUCKET="my-bucket"
# S3_REGION="us-east-1"           # R2: "auto"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_ENDPOINT=""                  # R2: https://<accountid>.r2.cloudflarestorage.com  (AWS: leave blank)
# S3_PUBLIC_URL=""                # public/CDN base for returned URLs (e.g. https://cdn.yoursite.com)
# S3_FORCE_PATH_STYLE="false"     # forced true automatically when S3_ENDPOINT is set
#
# Image optimization on upload (via sharp — a dependency, on by default). Uploads
# are auto-oriented, stripped of metadata (incl. GPS), downscaled and re-encoded.
# GIF/SVG pass through untouched. If sharp is unavailable the original is stored.
# IMAGE_OPTIMIZE="true"           # set "false" to store originals unchanged
# IMAGE_FORMAT="webp"             # webp (default) | jpeg | png | original
# IMAGE_MAX_DIM="2000"            # longest-edge cap in px
# IMAGE_QUALITY="80"              # 1..100

# ── Analytics rollups + retention ─────────────────────────────────────────
# A nightly job pre-aggregates events into daily rollups (powers the trends
# view) and prunes raw events past the retention window. See DEPLOYMENT.md §3d.
# ANALYTICS_RETENTION_DAYS="365"  # keep this many days of raw events; 0 = never prune
# CRON_SECRET="a-long-random-string"  # lets a host scheduler call POST /api/analytics/rollup
                                      #   with `Authorization: Bearer <CRON_SECRET>`

# ── "Listen to article" audio (ElevenLabs) — optional ─────────────────────
# Generates a text-to-speech MP3 per published article (a Listen button in the
# reader). Dormant until both are set; also needs persistent storage (S3_*) so
# the MP3s survive redeploys. Model defaults to the cost-efficient turbo model.
# ELEVENLABS_API_KEY="sk_xxxxxxxx"
# ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"   # pick a voice in your ElevenLabs account
# ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"       # optional

# ── JotForm ad-submission ingestion ───────────────────────────────────────
# Point a JotForm webhook at POST /api/ingest/jotform?key=<JOTFORM_WEBHOOK_SECRET>
# (or send the secret as the x-jotform-token header). Each submission becomes a
# DRAFT campaign + creatives for admin review — nothing serves until scheduled.
# Unset = ingestion endpoint is disabled (returns 503). See INTEGRATION.md.
# JOTFORM_WEBHOOK_SECRET="a-long-random-string"
# Map the hub's fields to your form's field keys (JSON). Defaults shown; override
# only the keys that differ (e.g. {"vendorName":"q3_company","plan":"q5_package"}).
# JOTFORM_FIELD_MAP='{"vendorName":"vendorName","email":"email","plan":"package","startDate":"startDate","endDate":"endDate","notes":"notes","images":"ads","paymentAmount":"paymentAmount","paymentId":"paymentId","paymentStatus":"paymentStatus"}'
# Payment fields are optional: if the form collects payment, map them and the hub
# records a Payment so the campaign can go live. Otherwise mark a campaign paid in
# the admin (comped / offline). A campaign can't schedule a flight until it's paid.
# The vendor's email (captured above) is stored on the Vendor and is where flight
# "fresh ads needed" + renewal reminders are sent (needs EMAIL_FROM + a provider
# key, see the email section above, to actually send; otherwise reminders are
# logged, not delivered). The reminder copy is admin-editable at
# /admin/email-templates.

# ── Content moderation (user-submitted text) ──────────────────────────────
# Extra blocked words for the reusable moderator (src/lib/moderation.ts), on top
# of the small built-in list. Comma-separated, whole-word, leet-normalized.
# MODERATION_BLOCKLIST="word1,word2,brandterm"
