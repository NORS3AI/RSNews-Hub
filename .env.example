# Copy to .env.local and adjust for your environment.

# Secret used to sign session cookies. MUST be a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-secret"

# Location of the SQLite database file (relative to project root or absolute).
DATABASE_PATH="./data/rsnews.db"

# Seed an initial admin account on first run.
SEED_ADMIN_EMAIL="admin@rsnews.local"
SEED_ADMIN_PASSWORD="admin1234"
