# ── RSNews Hub environment ────────────────────────────────────────────────
# Copy to `.env` for local dev. In production set these in your host's dashboard
# (never commit real values). See DEPLOYMENT.md for the full guide.

# Database connection.
#   Local dev (default):  SQLite file
#   Production:           Postgres — also change the datasource `provider` in
#                         prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Secret used to sign the hub's OWN session cookies (JWT), used only in
# AUTH_MODE=local. REQUIRED if you use local mode in production — the app refuses
# to issue sessions with a weak/placeholder value. Generate:  openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# ── How members are authenticated (see INTEGRATION.md) ────────────────────
# In production the hub is a gated area of the RS News site: the site verifies
# the member and the hub trusts that identity. Default "local" = the hub's own
# login (dev/standalone only; /login + /register are disabled in the other modes).
# AUTH_MODE="local"               # local | jwt | header
# --- AUTH_MODE=jwt (recommended for production) ---
# PARENT_JWT_SECRET="shared-hs256-secret-with-the-website"
# PARENT_SESSION_COOKIE="rsnews_sso"   # cookie the hub reads (default rsnews_sso)
# PARENT_JWT_ISSUER=""                 # optional, validated if set
# PARENT_JWT_AUDIENCE=""               # optional, validated if set
# --- AUTH_MODE=header (only behind a trusted proxy) ---
# PARENT_HEADER_ID="x-member-id"       # + x-member-email / -name / -type / -region / -store-type / -staff

# Admin account created by `npm run db:seed`. REQUIRED in production so no site
# ever ships with the public demo admin login.
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="use-a-strong-password"

# Optional: absolute site URL used for metadata / Open Graph tags, robots.txt
# and sitemap.xml. Set this in production so canonical/OG URLs are correct.
# SITE_URL="https://yoursite.com"

# Optional: transactional email (welcome mail, etc.). With BOTH unset the app
# logs messages instead of sending them, so nothing is emailed by accident.
# Uses Resend's REST API (no SDK). EMAIL_FROM must be a verified sender.
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="RSNews Hub <no-reply@yoursite.com>"

# Optional: error tracking. Errors always hit the structured logs; setting a DSN
# and wiring the one-line forwarder (see DEPLOYMENT.md) also ships them to Sentry.
# SENTRY_DSN="https://xxxx@oxxxx.ingest.sentry.io/xxxx"

# ── Asset storage (comic/ad/cover image uploads) ──────────────────────────
# Default (all unset): images are stored on LOCAL DISK under UPLOAD_DIR and
# served at /uploads/... — zero config, works out of the box. For multi-instance
# or serverless hosting use S3/R2 instead (below). See DEPLOYMENT.md §3c.
# STORAGE_DRIVER="local"          # "local" (default) or "s3". Omit to auto-detect.
# UPLOAD_DIR="./uploads"          # local-disk storage dir (use a persistent volume)
# UPLOAD_MAX_MB="8"               # max upload size in MB (default 8)
# UPLOAD_ALLOW_SVG="false"        # allow SVG uploads (off — SVG can carry script)
#
# S3 / Cloudflare R2 (S3-compatible). Set these to switch off local disk:
# S3_BUCKET="my-bucket"
# S3_REGION="us-east-1"           # R2: "auto"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_ENDPOINT=""                  # R2: https://<accountid>.r2.cloudflarestorage.com  (AWS: leave blank)
# S3_PUBLIC_URL=""                # public/CDN base for returned URLs (e.g. https://cdn.yoursite.com)
# S3_FORCE_PATH_STYLE="false"     # forced true automatically when S3_ENDPOINT is set
#
# Image optimization on upload (via sharp — a dependency, on by default). Uploads
# are auto-oriented, stripped of metadata (incl. GPS), downscaled and re-encoded.
# GIF/SVG pass through untouched. If sharp is unavailable the original is stored.
# IMAGE_OPTIMIZE="true"           # set "false" to store originals unchanged
# IMAGE_FORMAT="webp"             # webp (default) | jpeg | png | original
# IMAGE_MAX_DIM="2000"            # longest-edge cap in px
# IMAGE_QUALITY="80"              # 1..100

# ── Analytics rollups + retention ─────────────────────────────────────────
# A nightly job pre-aggregates events into daily rollups (powers the trends
# view) and prunes raw events past the retention window. See DEPLOYMENT.md §3d.
# ANALYTICS_RETENTION_DAYS="365"  # keep this many days of raw events; 0 = never prune
# CRON_SECRET="a-long-random-string"  # lets a host scheduler call POST /api/analytics/rollup
                                      #   with `Authorization: Bearer <CRON_SECRET>`
