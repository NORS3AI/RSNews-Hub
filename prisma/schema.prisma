generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Key/value store for site configuration (e.g. the admin-arranged homepage
// module layout, stored as a JSON string under key "homepage_layout").
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Curated external "Industry News" links, hand-picked by staff. Shown in a
// scrollable homepage module. `views` counts click-throughs; `postedAt` is
// when we added it (not the source's publish date).
model IndustryLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  source    String?  // optional display source; falls back to the URL's host
  views     Int      @default(0)
  order     Int      @default(0)
  active    Boolean  @default(true)
  postedAt  DateTime @default(now())
  createdAt DateTime @default(now())
}

// House/advertiser creative for in-article ads. Each ad can declare the
// competitors it must never appear alongside: if any of `competitors` (a
// comma-separated list of brand keywords) is mentioned in an article, this ad
// is suppressed in that article. `keywords` mark the ad's own brand terms so
// it can be shown as contextually relevant. See src/lib/ads.ts.
model Ad {
  id          String   @id @default(cuid())
  brand       String
  label       String?
  headline    String
  cta         String   @default("Learn more")
  href        String   @default("#")
  accent      String   @default("#E97D34")
  keywords    String   @default("") // comma-separated: this ad's own brand terms (relevance)
  competitors String   @default("") // comma-separated: hide this ad if any appears in the article
  imageWide   String?  // wide banner creative (~3:1) for the in-article slot; url or data URL
  imageRect   String?  // rectangle creative (~1.2:1) for the bottom slot; url or data URL
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// NOTE: SQLite does not support native enums. Status/role fields are strings
// with values constrained in the application layer (see src/lib/constants.ts):
//   Role:          ADMIN | EDITOR | USER
//   UserStatus:    ACTIVE | SUSPENDED | BANNED
//   ContentStatus: DRAFT | PUBLISHED | ARCHIVED | TRASHED

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         String        @default("USER")
  status       String        @default("ACTIVE")
  bio          String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  articles      Article[]
  subscriptions Subscription[]
  readingLogs   ReadingLog[]
  notes         String?
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  color       String    @default("#316bff")
  createdAt   DateTime  @default(now())

  articles      Article[]
  subscriptions Subscription[]
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())

  articles  ArticleTag[]
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  status      String    @default("DRAFT")
  featured    Boolean   @default(false)
  pinned      Boolean   @default(false)
  views       Int       @default(0)
  readMinutes Int       @default(1)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  tags        ArticleTag[]
  readingLogs ReadingLog[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A subscription is either to a specific category or a global "all articles" feed.
model Subscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId])
}

// Reading history powers the "if you read this, this might interest you" engine.
model ReadingLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@index([articleId])
  @@index([userId])
  @@index([sessionId])
}
