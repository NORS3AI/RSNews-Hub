generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Key/value store for site configuration (e.g. the admin-arranged homepage
// module layout, stored as a JSON string under key "homepage_layout").
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A custom homepage module built in the Module Studio. `tree` is a JSON string
// of the composition tree (see src/lib/studio.ts). Referenced from the homepage
// layout by the namespaced id `custom:<id>`. `published` gates whether it may
// appear on the public homepage.
model CustomModule {
  id        String    @id @default(cuid())
  name      String
  shape     String    @default("column")
  tree      String    @default("")
  published Boolean   @default(false)
  // Optional invisible expiry: when set (from the tree's expireDays at publish),
  // a sweep pulls the module off the homepage after this time and logs it.
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// "Backroom Humor" comics. The most recent active comic appears on the
// homepage; the rest live in the comics archive. active=false = archived.
model Comic {
  id        String   @id @default(cuid())
  title     String
  image     String   // url/path or data URL
  caption   String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  postedAt  DateTime @default(now())
  createdAt DateTime @default(now())
}

// Monthly reader poll with live results. One poll is typically active at a
// time; past polls live in the polls archive.
model Poll {
  id        String       @id @default(cuid())
  question  String
  active    Boolean      @default(true)
  // 'council' = the single hand-run reader poll shown in the council aside.
  // 'module'  = a poll built inside a Module Studio module (has its own timer;
  // excluded from the "one active council poll" rule).
  kind      String       @default("council")
  createdAt DateTime     @default(now())
  closesAt  DateTime?
  options   PollOption[]
  votes     PollVote[]
}

// Lightweight admin activity log. Currently records automated lifecycle events
// (e.g. a module poll's timer expiring) so admins have a trail of what happened.
model AdminLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  kind      String   // e.g. poll_closed
  message   String

  @@index([createdAt])
}

// One row per account that votes, enforcing a single vote per poll per user.
model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([pollId, userId])
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label  String
  votes  Int    @default(0)
  order  Int    @default(0)
}

// "Pop Quiz" — a short multiple-choice quiz with a 48-hour window. One quiz is
// active at a time; it shows as a small card on the homepage and vanishes (and
// stops accepting submissions) once `closesAt` passes. Correct answers are kept
// server-side only (never sent to the client) so staff can reveal them later in
// a reflection article. Raw submissions are logged in QuizResponse.
model Quiz {
  id          String         @id @default(cuid())
  title       String
  active      Boolean        @default(true)
  closesAt    DateTime       // typically createdAt + 48h
  submissions Int            @default(0)
  createdAt   DateTime       @default(now())
  questions   QuizQuestion[]
  responses   QuizResponse[]
}

model QuizQuestion {
  id      String       @id @default(cuid())
  quizId  String
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt  String
  order   Int          @default(0)
  options QuizOption[]
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  correct    Boolean      @default(false) // admin-only; never exposed publicly
  count      Int          @default(0)      // times chosen
  order      Int          @default(0)
}

// One row per reader submission; `answers` is a JSON map of questionId->optionId.
// Submitting requires a logged-in account and is limited to one per user.
model QuizResponse {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   String
  createdAt DateTime @default(now())

  @@unique([quizId, userId])
}

// Generic analytics event. One flexible table captures the whole pipeline —
// exposure (impressions), interaction (clicks/opens/saves), and outcome
// (reads/journeys) — with a few indexed columns for the common cuts and a JSON
// `props` blob for the long tail (campaign/creative/format/shape/aboveFold/…).
// See src/lib/analytics/*. Viewability + dwell are captured on impressions so a
// raw click count is never read in isolation.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  type        String   // impression | click | article_open | read | clip | search | pageview | session | ad_click …
  subjectType String?  // ad | article | module | clip | search | hub
  subjectId   String?  // adId / articleId / moduleId / clipId / query
  visitorId   String?  // stable anonymous id (rsnews_reader cookie)
  userId      String?  // set when logged in
  sessionId   String?  // per-browsing-session id (client sessionStorage)
  pageType    String?  // home | article | clippings | search | category | admin …
  placement   String?  // module id / ad slot
  path        String?
  device      String?  // desktop | mobile | tablet
  value       Float?   // dwellMs / scrollPct / activeMs / durationMs (per event)
  props       String?  // JSON: campaignId, creativeId, format, shape, aboveFold, position, category, imageType, viewable, …

  @@index([type, createdAt])
  @@index([subjectType, subjectId])
  @@index([sessionId])
  @@index([createdAt])
}

// Curated external "Industry News" links, hand-picked by staff. Shown in a
// scrollable homepage module. `views` counts click-throughs; `postedAt` is
// when we added it (not the source's publish date).
model IndustryLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  source    String?  // optional display source; falls back to the URL's host
  views     Int      @default(0)
  order     Int      @default(0)
  active    Boolean  @default(true)
  postedAt  DateTime @default(now())
  createdAt DateTime @default(now())
}

// House/advertiser creative for in-article ads. Each ad can declare the
// competitors it must never appear alongside: if any of `competitors` (a
// comma-separated list of brand keywords) is mentioned in an article, this ad
// is suppressed in that article. `keywords` mark the ad's own brand terms so
// it can be shown as contextually relevant. See src/lib/ads.ts.
model Ad {
  id          String   @id @default(cuid())
  brand       String
  label       String?
  headline    String
  cta         String   @default("Learn more")
  href        String   @default("#")
  accent      String   @default("#E97D34")
  keywords    String   @default("") // comma-separated: this ad's own brand terms (relevance)
  competitors String   @default("") // comma-separated: hide this ad if any appears in the article
  imageWide   String?  // wide banner creative (~3:1) for the in-article slot; url or data URL
  imageRect   String?  // rectangle creative (~1.2:1) for the bottom slot; url or data URL
  video       String?  // silent looping video creative (mp4/webm) for the rectangle slot
  videoPoster String?  // poster image shown before play / when reduced-motion is on
  active      Boolean  @default(true)
  // Vendor ads belong to a 3-month flight (paid inventory); house ads have no
  // flight and serve whenever active. A flighted ad is only live inside its
  // flight's scheduled window (auto-takedown is automatic — see lib/ads).
  flightId    String?
  flight      AdFlight? @relation(fields: [flightId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([flightId])
}

// Admin-editable copy for an outgoing email (keyed by purpose, e.g. 'fresh_ads',
// 'renewal'). Stored as plain text with {mergeTags}; the sender substitutes the
// vendor's values and renders text + branded HTML. Absent row → the built-in
// default copy is used (see src/lib/emailTemplates), so mail never goes out blank.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  body      String
  updatedAt DateTime @updatedAt
}

// One JotForm submission ingested by the hub. Recorded first (audit + raw
// payload), then processed into a DRAFT campaign + creatives for admin review.
// `submissionId` is unique so a webhook re-delivery can't double-create.
model AdSubmission {
  id           String   @id @default(cuid())
  submissionId String   @unique                 // JotForm submission id (idempotency key)
  formId       String?
  vendorId     String?                           // resolved Vendor
  campaignId   String?                           // draft AdCampaign created
  status       String   @default("RECEIVED")     // RECEIVED | PROCESSED | FAILED
  error        String?
  raw          String                            // raw submission JSON (audit)
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
}

// A vendor's purchase of an ad package. Everything runs in 3-month "flights";
// packages just chain more flights (3mo = 1, 6mo = 2, 12mo = 4). No creative is
// ever live longer than one flight — vendors submit fresh ads for each. `plan`
// is a catalog key (see src/lib/adPlans.ts), so new packages are config, not code.
// A vendor (advertiser). The single source of truth an ad account, its
// campaigns, and (later) its performance reports all hang off — so nothing keys
// off a brand *string*. `brandKey` is the normalized (trim+lowercase) match key,
// unique so "PackWise" and "packwise " can never split into two vendors; it's
// also what a logged-in vendor's `vendorBrand` resolves against.
model Vendor {
  id           String       @id @default(cuid())
  name         String                       // display name, as first entered
  brandKey     String       @unique         // normalized match key (see lib/vendors)
  contactEmail String?                      // reminders / performance reports (later phases)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  campaigns    AdCampaign[]
  reports      PerformanceReport[]
}

// A quarterly ad-performance report for one vendor. Auto-drafted from the ad
// analytics we already collect (see lib/analytics advertiserReport), then the
// admin reviews/edits the summary and publishes it — only PUBLISHED reports
// show on the vendor's dashboard. `metrics` is the JSON snapshot taken at
// generation time, so a published report is stable even as raw events age out.
model PerformanceReport {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  periodLabel String                          // e.g. "Q2 2026"
  periodStart DateTime
  periodEnd   DateTime
  status      String    @default("DRAFT")     // DRAFT | PUBLISHED
  summary     String    @default("")          // admin-authored note shown to the vendor
  metrics     String                          // JSON snapshot of the computed report
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@unique([vendorId, periodStart])            // one report per vendor per period
  @@index([vendorId, status])
}

model AdCampaign {
  id          String     @id @default(cuid())
  vendorName  String                       // display label kept for back-compat; the link is vendorId
  vendorId    String?                      // FK to the Vendor entity (nullable during/after transition)
  vendor      Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  plan        String                       // adPlans catalog key: 'quarter' | 'half' | 'annual' | 'premium' | …
  startAt     DateTime
  endAt       DateTime
  status      String     @default("DRAFT") // DRAFT | ACTIVE | COMPLETED | CANCELLED
  allowsVideo Boolean    @default(false)
  notes       String?
  createdAt   DateTime   @default(now())
  // Set once we've emailed the vendor to renew (campaign nearing its end), so the
  // nightly job never double-nudges. Cleared implies "renewal reminder still due".
  renewalRemindedAt DateTime?
  flights     AdFlight[]
  payments    Payment[]

  @@index([status])
  @@index([vendorId])
}

// A payment against a campaign. Recorded from the JotForm submission (if it
// collected payment) or entered manually by an admin. A campaign must have a
// PAID payment before any of its flights can be scheduled (go live) — see
// lib/payments + scheduleFlight. `externalId` (the provider's transaction id) is
// unique so a re-delivered webhook can't double-record the same charge.
model Payment {
  id           String      @id @default(cuid())
  campaignId   String?
  campaign     AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  vendorId     String?
  submissionId String?                              // the JotForm submission it came from
  provider     String      @default("manual")       // jotform | stripe | manual
  externalId   String?     @unique                  // provider transaction id (dedup)
  amountCents  Int         @default(0)
  currency     String      @default("usd")
  status       String      @default("PAID")         // PAID | PENDING | REFUNDED | FAILED
  note         String?
  createdAt    DateTime    @default(now())

  @@index([campaignId])
}

// One 3-month window within a campaign. Holds that window's creatives (~3, they
// rotate). Admin reviews then schedules a flight ("Go"); serving filters by the
// window so it auto-comes-down at endAt. `remindedAt` marks that we've nudged the
// vendor to submit fresh ads for the next flight.
model AdFlight {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  index      Int                            // 1-based flight number within the campaign
  startAt    DateTime
  endAt      DateTime
  status     String     @default("AWAITING") // AWAITING (needs creatives) | REVIEW | SCHEDULED | ENDED
  remindedAt DateTime?
  ads        Ad[]

  @@index([campaignId])
  @@index([status, startAt, endAt])
}

// NOTE: SQLite does not support native enums. Status/role fields are strings
// with values constrained in the application layer (see src/lib/constants.ts):
//   Role:          ADMIN | EDITOR | USER
//   UserStatus:    ACTIVE | SUSPENDED | BANNED
//   ContentStatus: DRAFT | PUBLISHED | ARCHIVED | TRASHED

model User {
  id           String        @id @default(cuid())
  // Link to the account in the PARENT site (RS News). In production the hub does
  // not own logins — the website authenticates members and hands us a verified
  // identity; this is the stable id we key all hub state (votes, clips, favorites)
  // to. Null for locally-created accounts in the standalone/dev "local" AUTH_MODE.
  externalId   String?       @unique
  email        String        @unique
  name         String
  passwordHash String        @default("")
  role         String        @default("USER")
  status       String        @default("ACTIVE")
  bio          String?
  // Audience + entitlement attributes, supplied by the parent site's login token
  // (see src/lib/identity + src/lib/entitlements). accountType is the audience
  // axis (distinct from `role`, which is permissions). tier/affiliations are
  // deliberately FREE-FORM strings so new membership types/networks are just
  // data — no code change. vendorBrand links a vendor account to its ad brand.
  accountType  String        @default("MEMBER") // MEMBER | VENDOR | STAFF (extensible)
  tier         String?       // e.g. BASIC | PREMIUM (free-form)
  affiliations String        @default("")       // comma-separated keys, e.g. "packagehub"
  vendorBrand  String?       // for vendors: the ad brand they own (favored ads + dashboard)
  storeType    String?       // e.g. franchise | independent | chain (member facet)
  region       String?       // e.g. Northeast | Midwest | South | West
  // Remembered UI theme (light | dark | rs). Lets the chosen theme follow the
  // member across devices; anonymous visitors fall back to localStorage.
  theme        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  articles      Article[]
  subscriptions Subscription[]
  readingLogs   ReadingLog[]
  quizResponses QuizResponse[]
  pollVotes     PollVote[]
  savedItems    SavedItem[]
  clippings     Clipping[]
  notes         String?
}

// Per-account saved articles: favorites (starred) + to-read (pinned). Stored
// server-side so they follow a signed-in member across devices (anonymous
// visitors keep a local-only copy in the browser). Title/slug are a denormalized
// snapshot so the lists render without joining articles.
model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // 'favorite' | 'toread'
  articleId String
  title     String
  slug      String
  createdAt DateTime @default(now())

  @@unique([userId, kind, articleId])
  @@index([userId, kind])
}

// Per-account news clippings (highlighted quotes + saved comic images).
model Clipping {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String   // the browser-generated id, for reconciliation/merge
  kind      String   // 'quote' | 'comic'
  title     String
  quote     String?
  author    String?
  slug      String?
  image     String?
  createdAt DateTime @default(now())

  @@unique([userId, clientId])
  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  color       String    @default("#316bff")
  createdAt   DateTime  @default(now())

  articles      Article[]      @relation("PrimaryCategory")
  extraArticles Article[]      @relation("ExtraCategories")
  subscriptions Subscription[]
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())

  articles  ArticleTag[]
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  status      String    @default("DRAFT")
  // Access gate: '' / 'public' = everyone; else an entitlement token checked
  // against the viewer (premium | vendor | staff | member | an affiliation key
  // like 'packagehub'). Enforced server-side on the article page. See lib/entitlements.
  requirement String    @default("")
  featured    Boolean   @default(false)
  pinned      Boolean   @default(false)
  views       Int       @default(0)
  readMinutes Int       @default(1)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Primary category drives the main badge/colour/sorting. extraCategories are
  // additional categories an article also belongs to (e.g. a Blog post that is
  // also Breaking News). breakingUntil, when in the future, shows the Breaking
  // badge and auto-expires once it passes.
  categoryId  String?
  category    Category? @relation("PrimaryCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  extraCategories Category[] @relation("ExtraCategories")
  breakingUntil DateTime?

  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  tags        ArticleTag[]
  readingLogs ReadingLog[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A subscription is either to a specific category or a global "all articles" feed.
model Subscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId])
}

// Reading history powers the "if you read this, this might interest you" engine.
model ReadingLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@index([articleId])
  @@index([userId])
  @@index([sessionId])
}

// Pre-aggregated daily analytics (one row per UTC day). Powers the trends view
// and, crucially, preserves history so raw AnalyticsEvent rows can be pruned by
// the retention policy without losing the long-term picture. Counts are summable
// across days; uniques (visitors/sessions) are per-day distinct — correct as a
// daily line, not as a range total (the same person across two days is two
// day-uniques). Rebuilt idempotently by the rollup job.
model AnalyticsDaily {
  date          String   @id           // 'YYYY-MM-DD' (UTC)
  events        Int      @default(0)   // total events that day
  pageviews     Int      @default(0)
  visitors      Int      @default(0)   // distinct visitorId that day
  sessions      Int      @default(0)   // distinct sessionId that day
  articleOpens  Int      @default(0)
  reads         Int      @default(0)   // finalized reads (milestone == null)
  adImpressions Int      @default(0)
  adViewable    Int      @default(0)
  adClicks      Int      @default(0)
  clipSaves     Int      @default(0)
  updatedAt     DateTime @updatedAt
}
