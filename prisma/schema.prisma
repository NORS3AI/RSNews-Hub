generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Key/value store for site configuration (e.g. the admin-arranged homepage
// module layout, stored as a JSON string under key "homepage_layout").
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Saved announcement-bar messages (a reusable library). Which one is live, and
// whether the bar is on at all, live in Setting rows (announcement:liveId /
// announcement:enabled) — so saving/editing a message never changes what's
// published or flips the on/off switch.
model Announcement {
  id            String    @id @default(cuid())
  name          String    @default("") // short library label
  message       String    @default("")
  href          String    @default("")
  hrefLabel     String    @default("")
  targetAt      DateTime?               // countdown target (null = no countdown)
  showCountdown Boolean   @default(false)
  size          String    @default("md")   // sm | md | lg
  ticker        Boolean   @default(false)  // scroll the message text
  order         String    @default("message,countdown,button") // element order
  audience      String    @default("")   // entitlement gate: '' = everyone; else a token (premium|packagehub|…)
  starred       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// A saved Report-builder configuration: press one to re-open the builder with
// the chosen scope / range / sections / charts and get freshly-computed numbers.
// `query` is the builder querystring (scope, days, brand, hide, viz) — nothing
// is frozen; every open recomputes live from analytics events.
model ReportTemplate {
  id        String   @id @default(cuid())
  name      String
  query     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Open newsletter signups — anyone (owner, manager or employee) can subscribe
// with just an email; the daily Industry News digest goes to these addresses.
// A personal EMAIL digest signup. Identity is the email address, NOT a hub
// login: a membership account is a whole store (owner + managers + employees all
// share the one login), so any individual who wants the digest at their own
// inbox just drops their email here. `topics` is a comma-separated list of what
// they want — "industry", "all", or category slugs (e.g. "industry,breaking-news
// ,education"). `accountId` is the store account that added it, so a store can
// see and manage every email it's put on the list.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  active         Boolean   @default(true)
  token          String    @unique // one-click unsubscribe token
  source         String?   // where they signed up (e.g. "homepage")
  topics         String    @default("industry")
  accountId      String?
  account        User?     @relation("AccountEmails", fields: [accountId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
}

// A custom homepage module built in the Module Studio. `tree` is a JSON string
// of the composition tree (see src/lib/studio.ts). Referenced from the homepage
// layout by the namespaced id `custom:<id>`. `published` gates whether it may
// appear on the public homepage.
model CustomModule {
  id        String    @id @default(cuid())
  name      String
  shape     String    @default("column")
  tree      String    @default("")
  published Boolean   @default(false)
  // Optional invisible expiry: when set (from the tree's expireDays at publish),
  // a sweep pulls the module off the homepage after this time and logs it.
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// "Backroom Humor" comics. The most recent active comic appears on the
// homepage; the rest live in the comics archive. active=false = archived.
model Comic {
  id        String   @id @default(cuid())
  title     String
  image     String   // url/path or data URL
  caption   String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  postedAt  DateTime @default(now())
  createdAt DateTime @default(now())
}

// Monthly reader poll with live results. One poll is typically active at a
// time; past polls live in the polls archive.
model Poll {
  id        String       @id @default(cuid())
  question  String
  active    Boolean      @default(true)
  // 'council' = the single hand-run reader poll shown in the council aside.
  // 'module'  = a poll built inside a Module Studio module (has its own timer;
  // excluded from the "one active council poll" rule).
  kind      String       @default("council")
  createdAt DateTime     @default(now())
  closesAt  DateTime?
  options   PollOption[]
  votes     PollVote[]
}

// Lightweight admin activity log. Currently records automated lifecycle events
// (e.g. a module poll's timer expiring) so admins have a trail of what happened.
model AdminLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  kind      String   // e.g. poll_closed
  message   String

  @@index([createdAt])
}

// One row per account that votes, enforcing a single vote per poll per user.
model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([pollId, userId])
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label  String
  votes  Int    @default(0)
  order  Int    @default(0)
}

// "Pop Quiz" — a short multiple-choice quiz with a 48-hour window. One quiz is
// active at a time; it shows as a small card on the homepage and vanishes (and
// stops accepting submissions) once `closesAt` passes. Correct answers are kept
// server-side only (never sent to the client) so staff can reveal them later in
// a reflection article. Raw submissions are logged in QuizResponse.
model Quiz {
  id          String         @id @default(cuid())
  title       String
  active      Boolean        @default(true)
  closesAt    DateTime       // typically createdAt + 48h
  submissions Int            @default(0)
  createdAt   DateTime       @default(now())
  questions   QuizQuestion[]
  responses   QuizResponse[]
}

model QuizQuestion {
  id      String       @id @default(cuid())
  quizId  String
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt  String
  order   Int          @default(0)
  options QuizOption[]
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  correct    Boolean      @default(false) // admin-only; never exposed publicly
  count      Int          @default(0)      // times chosen
  order      Int          @default(0)
}

// One row per reader submission; `answers` is a JSON map of questionId->optionId.
// Submitting requires a logged-in account and is limited to one per user.
model QuizResponse {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   String
  createdAt DateTime @default(now())

  @@unique([quizId, userId])
}

// Generic analytics event. One flexible table captures the whole pipeline —
// exposure (impressions), interaction (clicks/opens/saves), and outcome
// (reads/journeys) — with a few indexed columns for the common cuts and a JSON
// `props` blob for the long tail (campaign/creative/format/shape/aboveFold/…).
// See src/lib/analytics/*. Viewability + dwell are captured on impressions so a
// raw click count is never read in isolation.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  type        String   // impression | click | article_open | read | clip | search | pageview | session | ad_click …
  subjectType String?  // ad | article | module | clip | search | hub
  subjectId   String?  // adId / articleId / moduleId / clipId / query
  visitorId   String?  // stable anonymous id (rsnews_reader cookie)
  userId      String?  // set when logged in
  sessionId   String?  // per-browsing-session id (client sessionStorage)
  pageType    String?  // home | article | clippings | search | category | admin …
  placement   String?  // module id / ad slot
  path        String?
  device      String?  // desktop | mobile | tablet
  value       Float?   // dwellMs / scrollPct / activeMs / durationMs (per event)
  props       String?  // JSON: campaignId, creativeId, format, shape, aboveFold, position, category, imageType, viewable, …

  @@index([type, createdAt])
  @@index([subjectType, subjectId])
  @@index([sessionId])
  @@index([createdAt])
}

// Curated external "Industry News" links, hand-picked by staff. Shown in a
// scrollable homepage module. `views` counts click-throughs; `postedAt` is
// when we added it (not the source's publish date).
model IndustryLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  source    String?  // optional display source; falls back to the URL's host
  author    String   @default("Brandon Gale") // who posted it (byline)
  views     Int      @default(0)
  order     Int      @default(0)
  active    Boolean  @default(true)
  postedAt  DateTime @default(now())
  createdAt DateTime @default(now())
}

// House/advertiser creative for in-article ads. Each ad can declare the
// competitors it must never appear alongside: if any of `competitors` (a
// comma-separated list of brand keywords) is mentioned in an article, this ad
// is suppressed in that article. `keywords` mark the ad's own brand terms so
// it can be shown as contextually relevant. See src/lib/ads.ts.
model Ad {
  id          String   @id @default(cuid())
  brand       String
  label       String?
  headline    String
  cta         String   @default("Learn more")
  href        String   @default("#")
  accent      String   @default("#E97D34")
  keywords    String   @default("") // comma-separated: this ad's own brand terms (relevance)
  competitors String   @default("") // comma-separated: hide this ad if any appears in the article
  imageWide   String?  // wide banner creative (~3:1) for the in-article slot; url or data URL
  imageRect   String?  // rectangle creative (~1.2:1) for the bottom slot; url or data URL
  imageTall   String?  // tall "skyscraper" creative (~1:3) for a vertical module slot; url or data URL
  video       String?  // silent looping video creative (mp4/webm) for the rectangle slot
  videoPoster String?  // poster image shown before play / when reduced-motion is on
  active      Boolean  @default(true)
  // A reserved one-off creative (e.g. a sponsor's custom ad for their article):
  // NEVER enters the normal rotation — excluded at loadAds() — but is hand-pickable
  // by id and rendered where an editor inserts an "Insert sponsor ad" block.
  reserved    Boolean  @default(false)
  // EXPLICIT ownership flag: true = an RS-owned house ad (our own brands). This is
  // the ONLY reliable "is this ours" signal — the absence of a flight/schedule does
  // NOT imply house (an always-on outside advertiser has neither). Used as the safe
  // fallback when a vendor-connected article's vendor has no creative, so a
  // competitor can never fill the gap. Set it on RS's own creatives only.
  house       Boolean  @default(false)
  // Optional self-scheduling window for a manually-added (non-flighted) ad — lets
  // a one-off outside advertiser go live / come down on a date without a campaign.
  // Both null = always-on. Ignored for flighted ads.
  liveFrom    DateTime?
  liveUntil   DateTime?
  // Vendor ads belong to a 3-month flight (paid inventory); house ads have no
  // flight and serve whenever active. A flighted ad is only live inside its
  // flight's scheduled window (auto-takedown is automatic — see lib/ads).
  flightId    String?
  flight      AdFlight? @relation(fields: [flightId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([flightId])
}

// Admin-editable copy for an outgoing email (keyed by purpose, e.g. 'fresh_ads',
// 'renewal'). Stored as plain text with {mergeTags}; the sender substitutes the
// vendor's values and renders text + branded HTML. Absent row → the built-in
// default copy is used (see src/lib/emailTemplates), so mail never goes out blank.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  body      String
  updatedAt DateTime @updatedAt
}

// One JotForm submission ingested by the hub. Recorded first (audit + raw
// payload), then processed into a DRAFT campaign + creatives for admin review.
// `submissionId` is unique so a webhook re-delivery can't double-create.
model AdSubmission {
  id           String   @id @default(cuid())
  submissionId String   @unique                 // JotForm submission id (idempotency key)
  formId       String?
  vendorId     String?                           // resolved Vendor
  campaignId   String?                           // draft AdCampaign created
  status       String   @default("RECEIVED")     // RECEIVED | PROCESSED | FAILED
  error        String?
  raw          String                            // raw submission JSON (audit)
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
}

// One sponsored-CONTENT submission (a vendor's article copy + creative) that a
// JotForm delivers to the hub. Distinct from AdSubmission (which buys ad
// inventory): this BUILDS a DRAFT article for review. Recorded first (audit +
// raw), deduped on `submissionId`, then processed into a draft article + a
// reserved creative. NEVER auto-published. The vendor is matched typo-tolerantly
// (see lib/vendorMatch): a very close match auto-links; a plausible-but-uncertain
// match is held as `suggested` for the admin to confirm BEFORE any merge; no
// match creates a new (flagged) vendor. `confidence` is the 0–100 match score.
model ContentSubmission {
  id            String   @id @default(cuid())
  submissionId  String   @unique                 // JotForm submission id (idempotency key)
  formId        String?
  status        String   @default("RECEIVED")     // RECEIVED | PROCESSED | FAILED
  matchStatus   String   @default("new")          // auto | suggested | new | confirmed
  matchName     String?                           // vendor name exactly as submitted
  matchVendorId String?                           // the candidate vendor (auto/suggested/confirmed)
  confidence    Int      @default(0)              // 0–100 fuzzy-match confidence
  vendorId      String?                           // finally resolved Vendor (null while a suggestion is pending)
  articleId     String?                           // draft Article created
  adId          String?                           // reserved Ad created from the creative
  headline      String?                           // submitted headline (queue display)
  error         String?
  raw           String                            // raw submission JSON (audit)
  createdAt     DateTime @default(now())

  @@index([status, createdAt])
  @@index([matchStatus])
}

// A vendor's purchase of an ad package. Everything runs in 3-month "flights";
// packages just chain more flights (3mo = 1, 6mo = 2, 12mo = 4). No creative is
// ever live longer than one flight — vendors submit fresh ads for each. `plan`
// is a catalog key (see src/lib/adPlans.ts), so new packages are config, not code.
// A vendor (advertiser). The single source of truth an ad account, its
// campaigns, and (later) its performance reports all hang off — so nothing keys
// off a brand *string*. `brandKey` is the normalized (trim+lowercase) match key,
// unique so "PackWise" and "packwise " can never split into two vendors; it's
// also what a logged-in vendor's `vendorBrand` resolves against.
model Vendor {
  id           String       @id @default(cuid())
  name         String                       // display name, as first entered
  brandKey     String       @unique         // normalized match key (see lib/vendors)
  contactEmail String?                      // ADMIN-CURATED public "official" contact email (phone book); reminders/go-live fall back to it
  notes        String?
  // Set when the hub auto-created this vendor from an intake submission with no
  // confident match — surfaced in the intake queue so an admin can review the
  // new record (merge a duplicate, fill contact details) rather than it landing
  // silently.
  autoCreated  Boolean      @default(false)
  // Supplier fields. `premium` gates inclusion in the phone-book directory; the
  // rest populate the phone book. `phone` is the official sales line; `website`
  // is the advertiser's site; `supplierUrl` is their supplier page on our MAIN
  // website (we link out to it — the hub does not host supplier pages).
  premium      Boolean      @default(false)
  // Supplier lifecycle timestamps (set by saveVendorProfile on a premium change):
  // `premiumSince`   — when this vendor BECAME premium; drives the "New" arrival
  //                    badge in the directory (cleared per-account once seen).
  // `premiumEndedAt` — when premium was revoked; starts the phone-book grace. A
  //                    saved entry stays visible (with a "leaving" badge) for
  //                    SUPPLIER_GRACE_DAYS, then the sweep deactivates it (soft —
  //                    notes are retained and restored if the vendor rejoins).
  premiumSince   DateTime?
  premiumEndedAt DateTime?
  website      String?
  supplierUrl  String?                       // external supplier page on the main site
  contactName  String?                       // the supplier's contact person (sales rep)
  phone        String?
  blurb        String?                       // short description in the phone book
  logoUrl      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  campaigns    AdCampaign[]
  supplierSeens SupplierSeen[]
  reports      PerformanceReport[]
  savedBy      SavedSupplier[]
  testimonials Testimonial[]
  testimonialRequests TestimonialRequest[]
  supplierNotes SupplierNote[]
  reportRequests AdReportRequest[]
}

// A vendor's self-serve request for a performance report over a period. Rate-
// limited; staff fulfil it (build + send the report) and mark it done.
model AdReportRequest {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      String   // 'quarter' | '6mo' | 'year' | 'lifetime'
  status      String   @default("PENDING") // PENDING | FULFILLED
  createdAt   DateTime @default(now())
  fulfilledAt DateTime?

  @@index([vendorId])
  @@index([status])
}

// An admin ask, at spotlight time, for readers to vouch for a premium supplier.
// One active request per vendor; readers who have the supplier starred (and
// haven't submitted yet) get a nudge in their notifications feed.
model TestimonialRequest {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([vendorId])
}

// A reader's testimonial for a supplier. Submitted PENDING, reviewed in the
// advertiser admin area; when approved an admin can surface it on the public
// supplier page and/or that advertiser's vendor dashboard. One per user+vendor
// (re-submitting edits their own).
model Testimonial {
  id                    String   @id @default(cuid())
  vendorId              String
  vendor                Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorName            String   // account-holder name snapshot at submit time
  storeName             String?  // store/business name snapshot at submit time
  memberCode            String?  // member ID code snapshot (in-house only, never shown to advertisers)
  body                  String
  status                String   @default("PENDING") // PENDING | APPROVED | REJECTED
  showOnVendorDashboard Boolean  @default(false)     // admin included it in the vendor's document
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, vendorId])
  @@index([vendorId])
}

// A reader's private sticky notes for a supplier in their phone book. Each note
// is one square in a grid; add drops a new one, delete removes it.
model SupplierNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([userId, vendorId])
}

// A reader's personal "phone book" entry for a supplier (account-tied so it
// follows them across devices — unlike localStorage favorites). Holds the
// reader's own notes and OPTIONAL alternative contact details they add
// themselves (kept separate from the vendor's official contact info).
model SavedSupplier {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  note      String?
  altEmail  String?
  altPhone  String?
  // Soft-removal: set when the grace period after a vendor loses premium elapses.
  // The row + its notes are retained (not deleted) so a later rejoin can restore
  // them; the phone book and star state only ever show rows where this is null.
  removedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, vendorId])
  @@index([userId])
}

// Per-account record that a signed-in store has actually opened a supplier's
// phone-book detail. Powers the "New" arrival badge: a newly-premium supplier
// shows "New" to each account until that account has seen it (then a row lands
// here and the badge clears for them). One row per account+vendor.
model SupplierSeen {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  seenAt    DateTime @default(now())

  @@unique([userId, vendorId])
  @@index([userId])
}

// A set of advertisers that must never advertise alongside each other. If any
// member is named in an article, the others are suppressed in every ad slot of
// that article (see lib/adsServer: their brands are folded into each member ad's
// competitor terms). `brands` is a comma-separated list of advertiser brand names.
model CompetitorGroup {
  id        String   @id @default(cuid())
  name      String
  brands    String   @default("")
  createdAt DateTime @default(now())
}

// A quarterly ad-performance report for one vendor. Auto-drafted from the ad
// analytics we already collect (see lib/analytics advertiserReport), then the
// admin reviews/edits the summary and publishes it — only PUBLISHED reports
// show on the vendor's dashboard. `metrics` is the JSON snapshot taken at
// generation time, so a published report is stable even as raw events age out.
model PerformanceReport {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  periodLabel String                          // e.g. "Q2 2026"
  periodStart DateTime
  periodEnd   DateTime
  status      String    @default("DRAFT")     // DRAFT | PUBLISHED
  summary     String    @default("")          // admin-authored note shown to the vendor
  metrics     String                          // JSON snapshot of the computed report
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@unique([vendorId, periodStart])            // one report per vendor per period
  @@index([vendorId, status])
}

model AdCampaign {
  id          String     @id @default(cuid())
  vendorName  String                       // display label kept for back-compat; the link is vendorId
  vendorId    String?                      // FK to the Vendor entity (nullable during/after transition)
  vendor      Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  plan        String                       // adPlans catalog key: 'quarter' | 'half' | 'annual' | 'premium' | …
  startAt     DateTime
  endAt       DateTime
  status      String     @default("DRAFT") // DRAFT | ACTIVE | COMPLETED | CANCELLED
  allowsVideo Boolean    @default(false)
  notes       String?
  // The person who placed THIS order (from their JotForm submission), archived
  // with the order so the paper trail shows who to contact about it — each order
  // can be a different rep. Distinct from the vendor's public phone-book contact.
  // go-live + reminder emails address this person, falling back to the vendor's
  // curated contactEmail.
  contactName  String?
  contactEmail String?
  createdAt   DateTime   @default(now())
  // Set once we've emailed the vendor to renew (campaign nearing its end), so the
  // nightly job never double-nudges. Cleared implies "renewal reminder still due".
  renewalRemindedAt DateTime?
  // Set once we've emailed the vendor that their ads went live (first go-live), so
  // the "your ads are live" note is sent exactly once per campaign.
  liveNotifiedAt    DateTime?
  flights     AdFlight[]
  payments    Payment[]

  @@index([status])
  @@index([vendorId])
}

// A payment against a campaign. Recorded from the JotForm submission (if it
// collected payment) or entered manually by an admin. A campaign must have a
// PAID payment before any of its flights can be scheduled (go live) — see
// lib/payments + scheduleFlight. `externalId` (the provider's transaction id) is
// unique so a re-delivered webhook can't double-record the same charge.
model Payment {
  id           String      @id @default(cuid())
  campaignId   String?
  campaign     AdCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  vendorId     String?
  submissionId String?                              // the JotForm submission it came from
  provider     String      @default("manual")       // jotform | stripe | manual
  externalId   String?     @unique                  // provider transaction id (dedup)
  amountCents  Int         @default(0)
  currency     String      @default("usd")
  status       String      @default("PAID")         // PAID | PENDING | REFUNDED | FAILED
  note         String?
  createdAt    DateTime    @default(now())

  @@index([campaignId])
}

// One 3-month window within a campaign. Holds that window's creatives (~3, they
// rotate). Admin reviews then schedules a flight ("Go"); serving filters by the
// window so it auto-comes-down at endAt. `remindedAt` marks that we've nudged the
// vendor to submit fresh ads for the next flight.
model AdFlight {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  index      Int                            // 1-based flight number within the campaign
  startAt    DateTime
  endAt      DateTime
  status     String     @default("AWAITING") // AWAITING (needs creatives) | REVIEW | SCHEDULED | ENDED
  remindedAt DateTime?
  ads        Ad[]

  @@index([campaignId])
  @@index([status, startAt, endAt])
}

// NOTE: SQLite does not support native enums. Status/role fields are strings
// with values constrained in the application layer (see src/lib/constants.ts):
//   Role:          ADMIN | EDITOR | USER
//   UserStatus:    ACTIVE | SUSPENDED | BANNED
//   ContentStatus: DRAFT | PUBLISHED | ARCHIVED | TRASHED

model User {
  id           String        @id @default(cuid())
  // Link to the account in the PARENT site (RS News). In production the hub does
  // not own logins — the website authenticates members and hands us a verified
  // identity; this is the stable id we key all hub state (votes, clips, favorites)
  // to. Null for locally-created accounts in the standalone/dev "local" AUTH_MODE.
  externalId   String?       @unique
  email        String        @unique
  name         String
  passwordHash String        @default("")
  role         String        @default("USER")
  status       String        @default("ACTIVE")
  bio          String?
  // Audience + entitlement attributes, supplied by the parent site's login token
  // (see src/lib/identity + src/lib/entitlements). accountType is the audience
  // axis (distinct from `role`, which is permissions). tier/affiliations are
  // deliberately FREE-FORM strings so new membership types/networks are just
  // data — no code change. vendorBrand links a vendor account to its ad brand.
  accountType  String        @default("MEMBER") // MEMBER | VENDOR | STAFF (extensible)
  tier         String?       // e.g. BASIC | PREMIUM (free-form)
  affiliations String        @default("")       // comma-separated keys, e.g. "packagehub"
  vendorBrand  String?       // for vendors: the ad brand they own (favored ads + dashboard)
  storeType    String?       // e.g. franchise | independent | chain (member facet)
  storeName    String?       // the member's business/store name (from parent profile)
  memberCode   String?       // human-facing member ID code (in-house only)
  region       String?       // e.g. Northeast | Midwest | South | West
  // Remembered UI theme (light | dark | rs). Lets the chosen theme follow the
  // member across devices; anonymous visitors fall back to localStorage.
  theme        String?
  // Last time this (shared, account-wide) login opened the Notifications bell —
  // anything newer counts as unread for the whole store.
  notificationsSeenAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  articles       Article[]
  subscriptions  Subscription[]
  accountEmails  NewsletterSubscriber[] @relation("AccountEmails")
  readingLogs   ReadingLog[]
  articleRecommends ArticleRecommend[]
  quizResponses QuizResponse[]
  pollVotes     PollVote[]
  savedItems    SavedItem[]
  favFolders    FavoriteFolder[]
  clippings     Clipping[]
  articleRevisions ArticleRevision[]
  savedSuppliers SavedSupplier[]
  supplierSeens SupplierSeen[]
  testimonials  Testimonial[]
  supplierNotes SupplierNote[]
  reportRequests AdReportRequest[]
  notes         String?
}

// Per-account saved articles: favorites (starred) + to-read (pinned). Stored
// server-side so they follow a signed-in member across devices (anonymous
// visitors keep a local-only copy in the browser). Title/slug are a denormalized
// snapshot so the lists render without joining articles.
model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   // 'favorite' | 'toread'
  articleId String
  title     String
  slug      String
  // For an external pin (e.g. an Industry News link) — the destination to open
  // instead of the in-site article modal. Null for normal in-house articles.
  href      String?
  // Optional favorite folder (only meaningful for kind='favorite'). Nulled when
  // the folder is deleted so the item falls back to "Unfiled".
  folderId  String?
  folder    FavoriteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([userId, kind, articleId])
  @@index([userId, kind])
  @@index([folderId])
}

// Member-defined folders for grouping favorites (e.g. "Training", "Front
// counter", "Marketing"). Per account; deleting one just unfiles its favorites.
model FavoriteFolder {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime    @default(now())
  items     SavedItem[]

  @@index([userId])
}

// Per-account news clippings (highlighted quotes + saved comic images).
model Clipping {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String   // the browser-generated id, for reconciliation/merge
  kind      String   // 'quote' | 'comic'
  title     String
  quote     String?
  author    String?
  slug      String?
  image     String?
  createdAt DateTime @default(now())

  @@unique([userId, clientId])
  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  color       String    @default("#316bff")
  createdAt   DateTime  @default(now())

  articles      Article[]      @relation("PrimaryCategory")
  extraArticles Article[]      @relation("ExtraCategories")
  subscriptions Subscription[]
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())

  articles  ArticleTag[]
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  // Optional display byline that overrides the account name shown as "By …" in
  // the reader. Lets a colleague post on behalf of another author (e.g. via
  // Simple upload) without reassigning the article's owning account. Blank/null
  // = fall back to the author account's name.
  byline      String?
  coverImage  String?
  // Optional cover VIDEO (mp4/webm URL). When set, the big single surfaces — the
  // article reader (page + modal) and the homepage hero — autoplay it muted/looped
  // with coverImage as the poster/fallback. Everywhere small (cards, grids, social
  // previews, email) always uses coverImage. Blank/null = image-only cover.
  coverVideo  String?
  // Optional focal point for the cover, as a CSS object-position ("50% 30%").
  // null/blank = center. Honored wherever the cover is object-cover cropped.
  coverFocus  String?
  status      String    @default("DRAFT")
  // Access gate: '' / 'public' = everyone; else an entitlement token checked
  // against the viewer (premium | vendor | staff | member | an affiliation key
  // like 'packagehub'). Enforced server-side on the article page. See lib/entitlements.
  requirement String    @default("")
  // Optional editorial genre — the NATURE of the piece (opinion | sponsored |
  // press_release | update), a separate axis from topic categories. '' = none.
  // See lib/genre. Shown as a small badge; sponsored doubles as ad disclosure.
  genre       String    @default("")
  // Paid-placement window: while this is in the future the article is an ACTIVE
  // sponsor — it floats into the "Featured" homepage module (below the top three)
  // and auto-drops out when the date passes. Null = not sponsored. Set per deal
  // (default +30d). Independent of `genre`, though the two usually pair up.
  sponsoredUntil DateTime?
  // When a sponsored article originated from (or is tied to) a vendor's intake
  // submission, this links it to that Vendor so publishing can send the vendor a
  // "you're live" message. Plain id link (no FK relation) — the article stands on
  // its own if the vendor is later removed. sponsorNotifiedAt guards that
  // go-live message to once. Both null for ordinary editorial articles.
  sponsorVendorId  String?
  sponsorNotifiedAt DateTime?
  // The CONTACT for THIS article — the person + email who submitted it via JotForm.
  // Pinned per-article (not the vendor's general contact) because the submitter can
  // differ each time; the go-live email is addressed here first, falling back to the
  // vendor's latest contact, then the vendor name.
  sponsorContactName  String?
  sponsorContactEmail String?
  featured    Boolean   @default(false)
  pinned      Boolean   @default(false)
  views       Int       @default(0)
  // Reader endorsements ("Recommend" at the end of the article). Denormalized
  // count for fast reads/sorting; the per-reader rows (dedup + toggle) live in
  // ArticleRecommend. Never negative.
  recommends  Int       @default(0)
  readMinutes Int       @default(1)
  // Autosaved draft — a work-in-progress copy that NEVER affects the live
  // article. Autosave writes here (any status); the editor loads these when
  // present; a manual Save promotes them to the live columns and clears them.
  // This lets a PUBLISHED article be autosaved without pushing half-typed text
  // to readers. draftSavedAt is the "has an unsaved draft" flag + its timestamp.
  draftTitle    String?
  draftContent  String?
  draftExcerpt  String?
  draftCover    String?
  draftSavedAt  DateTime?
  // "Listen to article" TTS audio (ElevenLabs → S3). audioHash fingerprints the
  // spoken text the current MP3 was made from, so we only regenerate on a real
  // content change. Status: NONE (no audio) | PENDING (queued) | READY | FAILED.
  audioUrl       String?
  audioStatus    String    @default("NONE")
  audioHash      String?
  audioUpdatedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Primary category drives the main badge/colour/sorting. extraCategories are
  // additional categories an article also belongs to (e.g. a Blog post that is
  // also Breaking News). breakingUntil, when in the future, shows the Breaking
  // badge and auto-expires once it passes.
  categoryId  String?
  category    Category? @relation("PrimaryCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  extraCategories Category[] @relation("ExtraCategories")
  breakingUntil DateTime?

  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  // Optional reusable byline from the Byline library (a person: photo + name +
  // title). Takes precedence over the free-text `byline` and the author account.
  // Null = no library byline chosen → the generic "RS News Hub Team" default (or
  // the free-text `byline` if one was typed). onDelete: SetNull so removing a
  // library byline never deletes articles — they fall back to the default.
  bylineId    String?
  bylineRef   Byline?   @relation(fields: [bylineId], references: [id], onDelete: SetNull)

  // A private, shareable draft-preview link secret. Anyone with
  // /docs/article/<slug>?preview=<token> can see the unpublished article as a
  // reader would (and leave an approval / change request). Null until generated.
  previewToken String? @unique

  tags        ArticleTag[]
  readingLogs ReadingLog[]
  revisions   ArticleRevision[]
  reviews     ArticleReview[]
  vendorReviews VendorReviewRequest[]
  recommendedBy ArticleRecommend[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

// An editorial "genre" — the NATURE of a piece (Opinion, Sponsored, …), a
// separate axis from topic categories, shown as a small badge. Admin-editable so
// new ones (History, Education, …) can be added. `slug` is the stable token
// stored on Article.genre and compared in code; `builtin` rows can't be deleted
// and their slug can't change (the 'sponsored' slug is load-bearing — it drives
// the paid-content disclosure and the sponsor go-live email). `color` tints the
// badge. `archived` hides it from the picker without touching existing articles.
model Genre {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  color     String   @default("#64748b")
  builtin   Boolean  @default(false)
  archived  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archived, sortOrder])
}

// A reusable byline — a saved author identity (photo + name + title) an editor
// can attach to articles from a small library, instead of retyping it each time.
// Not a login account: covers in-house management, council members, and repeat
// contributors who never sign in. Editing one here updates it on every article
// that uses it (a title change, a new photo, a name change). `archived` hides it
// from the picker without breaking articles that already reference it. There is
// no "team" row — the generic "RS News Hub Team" default is what shows when an
// article has no byline chosen (see lib/byline.ts).
model Byline {
  id        String    @id @default(cuid())
  name      String
  // Optional job title / role shown under the name (e.g. "President, RS News").
  title     String?
  // Optional headshot URL. Any size — rendered in a fixed circular avatar
  // (object-cover center-crop), so no specific dimensions are required.
  photo     String?
  // Optional short bio. Shown only in the in-article Author card element (never in
  // the compact top byline). Editing it here updates every linked card.
  bio       String?
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]

  @@index([archived, name])
}

// The Newsroom — a shared "OneNote-style" drafts space. Any staffer (ADMIN or
// EDITOR) can open, read, and edit any doc; each doc is a tab. Bodies autosave as
// plain prose; the rich formatting/blocks happen in the real composer AFTER a
// one-button push. Author identity is a denormalized snapshot (id + name), not a
// FK to User — the same "stands on its own" pattern as ContentSubmission — so the
// doc keeps a readable trail even if an account changes. `pushedAt` marks a doc
// that has been handed off to the article editor (then it's hidden from the list).
model NewsroomDoc {
  id            String   @id @default(cuid())
  title         String   @default("Untitled draft")
  body          String   @default("")
  archived      Boolean  @default(false)
  // Set when the doc is pushed into the article composer; a pushed doc is removed
  // from the Newsroom (it "becomes" the draft article).
  pushedAt      DateTime?
  createdById   String?
  createdByName String?
  // Who last saved it + when (snapshot), for the "last edited by …" line and to
  // warn a second editor that someone else just changed the doc.
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  comments      NewsroomComment[]
  presence      NewsroomPresence[]

  @@index([archived, pushedAt, updatedAt])
}

// A note in a doc's comments thread. The admin's name is captured automatically
// when they post (auto-tagged authorship), so a thread always reads "who said
// what" without anyone typing their name.
model NewsroomComment {
  id         String      @id @default(cuid())
  docId      String
  doc        NewsroomDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String
  body       String
  createdAt  DateTime    @default(now())

  @@index([docId, createdAt])
}

// Lightweight presence: each staffer viewing a doc upserts a heartbeat row so the
// others can see who's here (and who's actively typing). "Active" is a recent
// `lastSeen`; stale rows are pruned opportunistically. No websockets — the client
// polls a sync action. This is the "live enough" model, not full co-editing.
model NewsroomPresence {
  id       String      @id @default(cuid())
  docId    String
  doc      NewsroomDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  userId   String
  userName String
  editing  Boolean     @default(false)
  lastSeen DateTime    @default(now())

  @@unique([docId, userId])
  @@index([docId, lastSeen])
}

// The house-style "rule book" — the admin-editable dictionary the Newsroom's
// style checker enforces. Each row is one term: its `canonical` house spelling
// plus the off-house `variants` to catch (a comma/newline blob parsed in
// lib/houseStyle — admins never write regex). `forceLowercase` is for terms we
// always lowercase (e-commerce). `builtin` rows seed the list and can be edited or
// disabled but not deleted; custom rows are fully removable. No code keys off a
// specific canonical, so any term can change.
model HouseStyleRule {
  id             String   @id @default(cuid())
  canonical      String
  variants       String   @default("")
  forceLowercase Boolean  @default(false)
  message        String?
  builtin        Boolean  @default(false)
  enabled        Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([enabled, sortOrder])
}

// One reader's endorsement of one article (the end-of-article "Recommend").
// A signed-in reader is deduped by (articleId, userId); an anonymous reader by
// (articleId, sessionId) — Postgres treats NULLs as distinct, so a row carries
// exactly ONE of the two keys and only collides with its own kind. Deleting the
// row toggles the recommend off; Article.recommends is the denormalized count.
model ArticleRecommend {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  createdAt DateTime @default(now())

  @@unique([articleId, userId])
  @@unique([articleId, sessionId])
  @@index([articleId])
}

// One "push this article to a vendor's dashboard for review" round. The admin
// creates a row per push (so createdAt is the paper trail of when each round was
// sent); the logged-in vendor answers Approve / Request changes ONCE, which
// stamps decision + decidedAt and LOCKS it — they can't reopen or flip it. A
// later push after edits is a NEW row (a fresh pending item; the old one stays
// visible + locked). Used for sponsored articles AND for vendors' What's Hot
// pieces. On the vendor's decision the app also writes an ArticleReview so the
// response shows in the admin Hub alongside link-reviewer feedback.
model VendorReviewRequest {
  id        String    @id @default(cuid())
  articleId String
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  vendorId  String                              // whose dashboard it's pushed to
  createdAt DateTime  @default(now())           // when the admin pushed it (paper trail)
  decision  String?                             // null = pending; 'approve' | 'change'
  message   String    @default("")              // the vendor's change-request text
  decidedAt DateTime?                           // when the vendor answered (locks the row)

  @@index([vendorId, createdAt])
  @@index([articleId])
}

// A reviewer's response on a draft preview. Reviewers aren't logged in — they
// self-identify by name; the preview token is the access control. Multiple
// reviewers aggregate per article. A 'change' that isn't resolved keeps the
// article in "Changes requested"; otherwise approvals show. Status strings are
// validated in app code (house convention — no DB enums).
model ArticleReview {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  decision  String   // 'approve' | 'change'
  message   String   @default("") // free text, long for change requests
  resolved  Boolean  @default(false) // admin marks a change request handled
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
}

// Point-in-time snapshots of an article's title/body, written on each meaningful
// save (and before a restore) so an editor can roll back. Capped per article.
model ArticleRevision {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title     String
  content   String
  excerpt   String?
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([articleId, createdAt])
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A subscription is either to a specific category or a global "all articles" feed.
// Account-wide ON-SITE notification topics. Because a login is shared by a whole
// store, these are per-account (userId), not per-person, and drive the shared
// Notifications bell. `kind` distinguishes the non-category topics: 'category'
// (with categoryId), 'industry' (Brandon's Industry News), or 'all'.
model Subscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String   @default("category") // 'category' | 'industry' | 'all'
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, kind, categoryId])
}

// Reading history powers the "if you read this, this might interest you" engine.
model ReadingLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@index([articleId])
  @@index([userId])
  @@index([sessionId])
}

// Pre-aggregated daily analytics (one row per UTC day). Powers the trends view
// and, crucially, preserves history so raw AnalyticsEvent rows can be pruned by
// the retention policy without losing the long-term picture. Counts are summable
// across days; uniques (visitors/sessions) are per-day distinct — correct as a
// daily line, not as a range total (the same person across two days is two
// day-uniques). Rebuilt idempotently by the rollup job.
model AnalyticsDaily {
  date          String   @id           // 'YYYY-MM-DD' (UTC)
  events        Int      @default(0)   // total events that day
  pageviews     Int      @default(0)
  visitors      Int      @default(0)   // distinct visitorId that day
  sessions      Int      @default(0)   // distinct sessionId that day
  articleOpens  Int      @default(0)
  reads         Int      @default(0)   // finalized reads (milestone == null)
  adImpressions Int      @default(0)
  adViewable    Int      @default(0)
  adClicks      Int      @default(0)
  clipSaves     Int      @default(0)
  updatedAt     DateTime @updatedAt
}
